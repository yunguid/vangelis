{
  "version": 2,
  "installCommand": "cd sound-engine/frontend && npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "sound-engine/frontend/dist",
  "routes": [
    {
      "src": "/api/status",
      "dest": "/api/status.js"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
